OPENAI_API_KEY=your_openai_api_key_here
PORT=8000
CHROMA_PERSIST_DIR=./chroma_db
WEAVIATE_URL=your_weaviate_url_here
WEAVIATE_API_KEY=your_weaviate_api_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Model Provider settings (options: openai, gemini)
LLM_PROVIDER=openai

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Residential Proxy URL to bypass YouTube IP blocks / bot protections (e.g., http://user:pass@proxy.webshare.io:port)
# PROXY_URL=http://user:pass@proxy.webshare.io:80

YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- App settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
